# AeroTwin Frontend Environment
# Copy this to .env and adjust as needed

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# 3D Model URL (served by the backend static files mount)
VITE_MODEL_URL=http://localhost:8000/3D_Models/rotax912engine.glb

# Telemetry polling interval in milliseconds
VITE_POLL_INTERVAL_MS=1000
