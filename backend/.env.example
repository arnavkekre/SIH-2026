# ============================================================
# Supabase
# ============================================================

SUPABASE_URL=
SUPABASE_KEY=

# ============================================================
# AeroTwin replay
# ============================================================

# false = start backend without replay
# true  = automatically start replay on startup
AEROTWIN_AUTOSTART_REPLAY=false

# Replay speed:
# 1.0 = real-time
# 2.0 = 2x
# 4.0 = 4x
# 10.0 = 10x
AEROTWIN_REPLAY_SPEED=1.0